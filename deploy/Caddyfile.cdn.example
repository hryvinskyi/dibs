# TLS from certificate files, behind a CDN that connects to this server and names the visitor in a
# header. Caddy believes that header only from the CDN's own addresses, and writes it again for
# dibs with the address it resolved, so a peer that reached the port without passing the CDN cannot
# forge it.
#
# Replace the example ranges with the ranges your CDN publishes, and X-Edge-Client-IP with the
# header it uses. In .env set:
#   DIBS_TRUST_PROXY=1
#   DIBS_TRUSTED_PROXIES=172.31.250.0/24     (the compose file's `edge` network)
#   DIBS_CLIENT_IP_HEADER=X-Edge-Client-IP
# and admit only the CDN's ranges to the published port in the host's firewall.
#
# No `encode` directive: the event stream must never be compressed or buffered. No access log is
# configured, so no request header (Cookie, Authorization) is written anywhere.
{
	auto_https off
	admin off

	servers {
		trusted_proxies static 192.0.2.0/24 198.51.100.0/24 2001:db8::/32
		client_ip_headers X-Edge-Client-IP
	}
}

{$DIBS_HOST}:{$DIBS_PORT} {
	tls /certs/cert.pem /certs/key.pem

	reverse_proxy dibs:8080 {
		flush_interval -1
		header_up X-Edge-Client-IP {client_ip}
	}
}
