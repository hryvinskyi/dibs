# Copy to `.env` beside compose.yml and edit. Compose reads this file for the stack, and the dibs
# container receives it as its environment.

# --- The stack ---------------------------------------------------------------------------------

# The release of the image to run. Pin a release such as 1.2.3 for anything but a trial.
DIBS_VERSION=latest

# The public name of the server, as clients write it in .dibs.toml (Caddy matches it).
DIBS_HOST=dibs.example.com

# The port Caddy listens on, inside the container and on the host.
DIBS_PORT=443

# --- The server --------------------------------------------------------------------------------

# Take the client's address from the proxy in front (1) or from the connection (0). With 1,
# DIBS_TRUSTED_PROXIES must name the proxies.
DIBS_TRUST_PROXY=1

# The proxies whose word on the client's address is taken, as CIDRs. The compose file's `edge`
# network has this subnet; keep the two equal.
DIBS_TRUSTED_PROXIES=172.31.250.0/24

# The header the proxy names the client in. Caddy writes X-Forwarded-For; behind a CDN, name the
# header your Caddyfile sets.
DIBS_CLIENT_IP_HEADER=X-Forwarded-For

# The most detailed level logged: error, warn, info, debug, trace or off.
DIBS_LOG=info

# How often a snapshot of the database is taken (a number and s, m, h or d: 1m to 30d).
DIBS_SNAPSHOT_EVERY=6h

# How many of the newest snapshots are kept (1 to 10000).
DIBS_SNAPSHOT_KEEP=28

# Not set here, because the image fixes them: DIBS_DATABASE=/data/dibs.db, DIBS_SNAPSHOT_DIR=/snapshots
# and DIBS_LISTEN=0.0.0.0:8080 (the default).
