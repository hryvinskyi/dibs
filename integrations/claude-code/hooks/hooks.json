{
  "description": "dibs: the brief at the start of a session, a check before each file edit and each shell command, heartbeats after tools run, a teammate's pressing message or a slot offered to you between tool calls and with your prompt, a note of when a turn ends, so that a message pushed while the session waits is not pushed while it works, and the worktrees your sessions and subagents ask for, lent from your machine's pool and let go of when a subagent or the session ends.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" post-tool-use",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" pre-tool-use",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" session-end",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" session-start",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" check-binary",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" stop",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" subagent-stop",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" user-prompt-submit",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" worktree-create",
            "timeout": 900,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/dibs-hook\" worktree-remove",
            "onFailure": "continue",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
